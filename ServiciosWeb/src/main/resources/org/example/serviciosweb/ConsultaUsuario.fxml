<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="485.0" prefWidth="772.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.serviciosweb.controller.UsarioController">
   <children>
      <Label layoutX="14.0" layoutY="14.0" text="Consulta de usuarios - API REST">
         <font>
            <Font name="System Bold" size="18.0" />
         </font>
      </Label>
      <Button fx:id="btnConsultar" layoutX="14.0" layoutY="43.0" mnemonicParsing="false" onAction="#consultarUsuario" text="Consultar usuarios" />
      <Label fx:id="lblEstado" layoutX="152.0" layoutY="48.0" text="Presionar Consultar usuarios" />
      <TableView fx:id="tblUsuarios" layoutX="14.0" layoutY="85.0" prefHeight="384.0" prefWidth="741.0">
        <columns>
          <TableColumn fx:id="colId" prefWidth="46.0" text="Id" />
          <TableColumn fx:id="colNombre" prefWidth="120.0" text="Nombre" />
            <TableColumn fx:id="colUsername" prefWidth="102.0" text="Username" />
            <TableColumn fx:id="colCorreo" prefWidth="111.0" text="Correo" />
            <TableColumn fx:id="coltelefono" prefWidth="99.0" text="Telefono" />
            <TableColumn fx:id="colciudad" prefWidth="150.0" text="Ciudad" />
            <TableColumn fx:id="colEmpresa" prefWidth="112.0" text="Empresa" />
        </columns>
      </TableView>
   </children>
</AnchorPane>
